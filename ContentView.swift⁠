    var filteredApps: [AppItem] {
        if searchText.isEmpty { return appsList }
        return appsList.filter { $0.name.localizedCaseInsensitiveContains(searchText) }
    }

    func loadAppToSigner(app: AppItem) {
        editAppName = app.name
        editBundleID = app.bundleID
        editVersion = app.version
        selectedTab = 1
    }

    func fetchSourceData(urlStr: String) {
        guard let url = URL(string: urlStr) else { return }
        URLSession.shared.dataTask(with: url) { data, _, _ in
            if let data = data {
                if let decoded = try? JSONDecoder().decode([String: [AppItem]].self, from: data) {
                    let newApps = decoded["apps"] ?? decoded["applications"] ?? []
                    DispatchQueue.main.async {
                        self.appsList.append(contentsOf: newApps)
                        self.sourcesList.append(AppSource(name: "سورس خارجي", url: urlStr, appCount: newApps.count))
                    }
                }
            }
        }.resume()
    }

