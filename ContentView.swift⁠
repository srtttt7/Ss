import SwiftUI
import UniformTypeIdentifiers

// MARK: - Models
struct AppItem: Identifiable, Codable {
    var id = UUID()
    let name: String
    let bundleID: String
    let version: String
    let size: String
    let iconURL: String
    let downloadURL: String
}

struct AppSource: Identifiable, Codable {
    var id = UUID()
    let name: String
    let url: String
    let appCount: Int
}

