// MARK: - Modal Views
struct SourcesView: View {
    @Binding var sourcesList: [AppSource]
    var fetchSourceAction: (String) -> Void
    @State private var inputURL = ""
    @Environment(\.dismiss) var dismiss

    var body: some View {
        NavigationStack {
            VStack(spacing: 20) {
                TextField("رابط السورس (JSON)", text: $inputURL)
                    .padding()
                    .background(Color(white: 0.15))
                    .cornerRadius(12)

                Button("جلب السورس") {
                    if !inputURL.isEmpty {
                        fetchSourceAction(inputURL)
                        dismiss()
                    }
                }
                .fontWeight(.bold)
                .frame(maxWidth: .infinity)
                .padding()
                .background(Color.blue)
                .foregroundColor(.white)
                .cornerRadius(25)

                Spacer()
            }
            .padding()
            .navigationTitle("إضافة سورس")
            .preferredColorScheme(.dark)
        }
    }
}

