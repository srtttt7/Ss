import SwiftUI
import UniformTypeIdentifiers

// MARK: - Models
struct AppItem: Identifiable, Codable {
    var id = UUID()
    let name: String
    let bundleID: String
    let version: String
    let size: String
    let iconURL: String
    let downloadURL: String

    enum CodingKeys: String, CodingKey {
        case name
        case bundleID = "bundleIdentifier"
        case version
        case size
        case iconURL = "icon"
        case downloadURL = "downloadURL"
    }
}

struct AppSource: Identifiable, Codable {
    var id = UUID()
    let name: String
    let url: String
    let appCount: Int
}

